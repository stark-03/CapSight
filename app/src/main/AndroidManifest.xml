<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Camera stream and health probe over the cap's Wi-Fi (CLAUDE.md §6.1, §6.3) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- PhoneCameraSource, the Phase-A test source (FR-RX-05). Runtime permission. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- P0 alerts vibrate (FR-VOICE-06); P2 too while speech is unavailable -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Foreground service that keeps guidance running with the screen off (FR-APP-03, §6.1) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />

    <!-- API 30+: without this the text-to-speech engine is invisible (CLAUDE.md §6.1) -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <!-- The cap camera is the real source; a phone without a rear camera still works. -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CapSight">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.CapSight"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- connectedDevice: the cap camera over Wi-Fi. camera: only when the phone's own camera
             is the source (added at start, while the app is in the foreground). -->
        <service
            android:name=".service.NavigationService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice|camera" />
    </application>

</manifest>
