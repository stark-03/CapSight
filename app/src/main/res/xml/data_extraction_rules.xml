<data-extraction-rules>
    <cloud-backup>
        <!-- Decision logs stay on the phone (CLAUDE.md §10, Privacy). -->
        <exclude domain="file" path="decision_logs/" />
        <!-- TODO: Use <include> and <exclude> to control what is backed up.
        <include .../>
        <exclude .../>
        -->
    </cloud-backup>
    <!--
    <device-transfer>
        <include .../>
        <exclude .../>
    </device-transfer>
    -->
</data-extraction-rules>